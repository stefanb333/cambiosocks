# --- Osnovno ---
# Javna adresa sajta (bez kose crte na kraju). Lokalno: http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Nasumičan string od najmanje 32 znaka: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# --- Baza (Neon Postgres) ---
# Neon: Dashboard > Connection Details > "Pooled connection" string, sa ?sslmode=require
# Lokalno (npm run db:local): postgres://postgres:postgres@127.0.0.1:54329/cambio
DATABASE_URL=

# --- Slike (Cloudflare R2, S3 kompatibilno) ---
# Ako je S3_BUCKET prazan, slike se čuvaju lokalno u /media (samo za razvoj).
S3_BUCKET=
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Javni URL bucketa (R2 > Settings > Public access / custom domen), npr. https://media.cambio.rs
S3_PUBLIC_URL=
# 1 = admin šalje slike direktno u bucket (zaobilazi limit od ~6 MB na Netlify-u).
# Uključiti tek kad je na bucketu podešen CORS, vidi docs/PUSTANJE-U-RAD.md.
S3_CLIENT_UPLOADS=

# --- Email (Resend) ---
RESEND_API_KEY=
# Pošiljalac sa verifikovanog domena, npr. "Cambio <porudzbine@cambio.rs>"
EMAIL_FROM=
# Adresa na koju stižu obaveštenja o novim porudžbinama i kontakt porukama
EMAIL_NOTIFY_TO=

# --- Revalidacija ---
# Tajna za ručni poziv /api/revalidate (on-demand revalidacija se inače radi iz Payload hookova)
REVALIDATE_SECRET=

# --- Demo / probni sajt ---
# 1 = ceo sajt zatvoren za pretraživače (noindex). Samo za demo, nikad na pravom sajtu.
SITE_NOINDEX=
# --- Seed (opciono) ---
# Ako su postavljeni, "npm run seed" pravi admin nalog. Ne koristiti u produkciji.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
